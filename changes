## BTRFS subvolumes setup

mount -o subvolid=5 /dev/XXX /mnt
btrfs subvolume snapshot /mnt /mnt/@        // clones root into @
btrfs subvolume create /mnt/@home
btrfs subvolume create /mnt/@snapshots
cp -a --reflink=always /mnt/@/home/. /mnt/@home/
rm -rf /mnt/@/home/*
rm -rf /mnt/@/home/.[!.]* 2>/dev/null
mkdir -p /mnt/@/home /mnt/@/.snapshots      // for future mountpoints

mkdir /mnt/old_root_backup
mv /mnt/boot /mnt/old_root_backup/
mv /mnt/etc /mnt/old_root_backup/
mv /mnt/home /mnt/old_root_backup/
mv /mnt/root /mnt/old_root_backup/
mv /mnt/usr /mnt/old_root_backup/
mv /mnt/var /mnt/old_root_backup/
mv /mnt/opt /mnt/old_root_backup/
mv /mnt/srv /mnt/old_root_backup/

mv /mnt/bin /mnt/old_root_backup/
mv /mnt/sbin /mnt/old_root_backup/
mv /mnt/lib /mnt/old_root_backup/
mv /mnt/lib64 /mnt/old_root_backup/         // basically moves everything from /mnt into backup (non user-merged first)

umount -R /mnt
mount -o subvol=@,$OPT /dev/XXX /mnt
mount -o subvol=@home,$OPT /dev/XXX /mnt/home
mount -o subvol=@snapshots,$OPT /dev/XXX /mnt/.snapshots
mount /dev/YYY /mnt/boot/efi

xgenfstab /mnt > /mnt/etc/fstab
Edit /etc/fstab to have all options : ssd,discard=async,space_cache=v2,noatime,compress=zstd:3

xchroot /mnt
Add 'rootflags=subvol=@' kernel parameter to GRUB, then regen GRUB config/initramfs.
GRUB itself needs to be reinstalled through grub-install to lever the exact mountpoint change. Else 'error: /boot/grub/x86_64/normal.mod not found'.

exit, umount -R /mnt, reboot






